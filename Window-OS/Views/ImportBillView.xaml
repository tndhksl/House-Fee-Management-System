<UserControl x:Class="ManagementHouseFee.Views.ImportBillView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 내용이 비어 있으면 숨기는 TextBlock 스타일 -->
        <Style x:Key="HideWhenEmpty" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 제목 -->
        <Border Grid.Row="0" Background="White" Padding="20,15" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="📥 관리비 불러오기" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="{Binding StatusMessage}" Foreground="Gray" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 왼쪽: 드래그앤드롭 영역 + 파일 목록 -->
            <DockPanel Grid.Column="0" Margin="0,0,10,0">
                <Grid x:Name="DropZone" DockPanel.Dock="Top" Height="170" Background="White" Cursor="Hand"
                      AllowDrop="True"
                      DragEnter="DropZone_DragEnter" DragOver="DropZone_DragOver"
                      DragLeave="DropZone_DragLeave" Drop="DropZone_Drop"
                      MouseLeftButtonUp="DropZone_Click">
                    <Rectangle x:Name="DropBorder" Stroke="#9E9E9E" StrokeThickness="2" StrokeDashArray="6 4"
                               RadiusX="10" RadiusY="10"/>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock Text="🖼️" FontSize="36" HorizontalAlignment="Center"/>
                        <TextBlock Text="고지서 캡처를 여기로 끌어다 놓으세요" FontSize="15" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        <TextBlock Text="또는 클릭해서 선택 · 여러 장 가능" FontSize="12" Foreground="Gray"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <Button Content="고지서 읽기" Command="{Binding ExtractCommand}" FontSize="16" Padding="0,8"
                            Background="#333333" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                    <Button Content="모두 지우기" Command="{Binding ClearFilesCommand}" FontSize="13" Padding="0,5"
                            Margin="0,6,0,0" Background="White" Cursor="Hand"/>
                    <TextBlock Text="고지서를 읽는 중..." Foreground="#1565C0" HorizontalAlignment="Center" Margin="0,6,0,0"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>

                <ScrollViewer Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding SelectedFiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" CornerRadius="6" Padding="6" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Image Source="{Binding Path}" Height="48" Width="32" Stretch="UniformToFill"/>
                                        <TextBlock Grid.Column="1" Text="{Binding FileName}" VerticalAlignment="Center"
                                                   Margin="8,0" TextTrimming="CharacterEllipsis"/>
                                        <Button Grid.Column="2" Content="✕" Width="26" Height="26" Background="Transparent"
                                                BorderThickness="0" Cursor="Hand" Foreground="Gray"
                                                Command="{Binding DataContext.RemoveFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <!-- 오른쪽: 추출 결과 확인·수정 -->
            <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="청구월" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding Year, TargetNullValue='', UpdateSourceTrigger=PropertyChanged}"
                                     Width="70" Margin="10,0,4,0" FontSize="15" HorizontalContentAlignment="Center"/>
                            <TextBlock Text="년" VerticalAlignment="Center" FontSize="15"/>
                            <TextBox Text="{Binding Month, TargetNullValue='', UpdateSourceTrigger=PropertyChanged}"
                                     Width="45" Margin="10,0,4,0" FontSize="15" HorizontalContentAlignment="Center"/>
                            <TextBlock Text="월" VerticalAlignment="Center" FontSize="15"/>
                        </StackPanel>

                        <CheckBox IsChecked="{Binding UseBillNames}" Margin="0,10,0,0" FontSize="14" VerticalContentAlignment="Center"
                                  Content="고지서 항목명 그대로 저장 (끄면 전기세·수도세·관리비로 묶어서 저장)"/>

                        <TextBlock Text="{Binding SumCheckMessage}" FontSize="14" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource HideWhenEmpty}">
                                    <Setter Property="Foreground" Value="#D9534F"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSumOk}" Value="True">
                                            <Setter Property="Foreground" Value="#2E7D32"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding WarningText}" Foreground="#E65100" FontSize="13" Style="{StaticResource HideWhenEmpty}"/>
                        <TextBlock Text="{Binding NotesText}" Foreground="Gray" FontSize="12" Style="{StaticResource HideWhenEmpty}"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <Button Content="확인하고 저장" Command="{Binding SaveCommand}" HorizontalAlignment="Right"
                                FontSize="15" Padding="18,7" Margin="0,10,0,0"
                                Background="#2E7D32" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                    </StackPanel>

                    <!-- 항목 표: 금액 수정, 분류 선택 가능. 미분류 행은 주황색 -->
                    <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" CanUserAddRows="False"
                              CanUserDeleteRows="False" HeadersVisibility="Column" Margin="0,10,0,0"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEEEEE" FontSize="14"
                              RowHeight="32">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Category}" Value="{x:Null}">
                                        <Setter Property="Background" Value="#FFF4E5"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="고지서 항목" Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="금액(원)" Binding="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                            <DataGridTemplateColumn Header="앱 항목" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedItem="{Binding Category, UpdateSourceTrigger=PropertyChanged}"
                                                  ItemsSource="{Binding DataContext.Categories, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
