<UserControl x:Class="ManagementHouseFee.Views.ChatWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="500">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <LinearGradientBrush x:Key="BotGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4F46E5" Offset="0"/>
            <GradientStop Color="#7C3AED" Offset="1"/>
        </LinearGradientBrush>

        <!-- 챗봇 얼굴 아이콘 (직접 그린 벡터 도형: 안테나 달린 둥근 로봇) -->
        <ControlTemplate x:Key="BotFace" TargetType="Control">
            <Viewbox>
                <Canvas Width="32" Height="32">
                    <Line X1="16" Y1="3" X2="16" Y2="9" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round"/>
                    <Ellipse Canvas.Left="13.5" Canvas.Top="0.5" Width="5" Height="5" Fill="#FDE68A"/>
                    <Rectangle Canvas.Left="4" Canvas.Top="9" Width="24" Height="18" RadiusX="7" RadiusY="7" Fill="White"/>
                    <Rectangle Canvas.Left="1.5" Canvas.Top="15" Width="3" Height="7" RadiusX="1.5" RadiusY="1.5" Fill="White"/>
                    <Rectangle Canvas.Left="27.5" Canvas.Top="15" Width="3" Height="7" RadiusX="1.5" RadiusY="1.5" Fill="White"/>
                    <Ellipse Canvas.Left="10" Canvas.Top="14.5" Width="4.5" Height="4.5" Fill="#4F46E5"/>
                    <Ellipse Canvas.Left="17.5" Canvas.Top="14.5" Width="4.5" Height="4.5" Fill="#4F46E5"/>
                    <Path Data="M12,22 Q16,25 20,22" Stroke="#4F46E5" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Canvas>
            </Viewbox>
        </ControlTemplate>

        <Style x:Key="HideWhenEmpty" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- 배경을 비워 두어서(null) 빈 공간 클릭은 아래 화면으로 그대로 전달된다 -->
    <Grid>
        <!-- 채팅 창 -->
        <Border Width="370" Height="470" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,90"
                CornerRadius="14" Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.25"/>
            </Border.Effect>

            <DockPanel>
                <!-- 머리글 -->
                <Border DockPanel.Dock="Top" Background="{StaticResource BotGradient}" CornerRadius="14,14,0,0" Padding="14,10">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="✕" Command="{Binding ToggleCommand}" Foreground="White"
                                Background="Transparent" BorderThickness="0" FontSize="16" Cursor="Hand"/>
                        <Control Template="{StaticResource BotFace}" Width="26" Height="26"/>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="관리비 도우미" Foreground="White" FontWeight="Bold" FontSize="15"/>
                            <TextBlock Text="앱 계산 결과로만 답해요" Foreground="#E0E7FF" FontSize="11"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- 입력창 -->
                <Border DockPanel.Dock="Bottom" BorderBrush="#EEEEEE" BorderThickness="0,1,0,0" Padding="10">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="➤" Command="{Binding SendCommand}" Width="40" Margin="8,0,0,0"
                                Background="{StaticResource BotGradient}" Foreground="White" BorderThickness="0" FontSize="16" Cursor="Hand"/>
                        <TextBox Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="8,6"
                                 VerticalContentAlignment="Center">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SendCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                    </DockPanel>
                </Border>

                <!-- 예시 질문 -->
                <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding Examples}" Margin="10,6,10,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding}" CommandParameter="{Binding}" FontSize="12" Padding="8,3" Margin="0,0,6,6"
                                    Background="#EEF2FF" Foreground="#4338CA" BorderThickness="0" Cursor="Hand"
                                    Command="{Binding DataContext.SendExampleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 대화 내용 -->
                <ScrollViewer x:Name="MessageScroll" VerticalScrollBarVisibility="Auto" Padding="12,8"
                              ScrollChanged="MessageScroll_ScrollChanged">
                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Bubble" CornerRadius="12" Padding="10,8" Margin="0,4" MaxWidth="280"
                                        HorizontalAlignment="Left" Background="#F1F1F4">
                                    <StackPanel>
                                        <TextBlock x:Name="MessageText" Text="{Binding Text}" TextWrapping="Wrap" FontSize="14" Foreground="#222222"/>
                                        <TextBlock x:Name="DetailText" Text="{Binding Detail}" FontSize="11" Margin="0,6,0,0"
                                                   Foreground="#2E7D32" Style="{StaticResource HideWhenEmpty}"/>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsUser}" Value="True">
                                        <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right"/>
                                        <Setter TargetName="Bubble" Property="Background" Value="#4F46E5"/>
                                        <Setter TargetName="MessageText" Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                        <Setter TargetName="DetailText" Property="Foreground" Value="#D9534F"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- 오른쪽 아래 떠 있는 챗봇 아이콘 -->
        <Button Width="60" Height="60" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,20"
                Command="{Binding ToggleCommand}" Cursor="Hand" ToolTip="관리비 도우미">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                        <Ellipse Fill="{StaticResource BotGradient}">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.35"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <Control Template="{StaticResource BotFace}" Margin="13"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1.08" ScaleY="1.08"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</UserControl>