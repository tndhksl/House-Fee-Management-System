<Window x:Class="ManagementHouseFee.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ManagementHouseFee.ViewModels"
        xmlns:views="clr-namespace:ManagementHouseFee.Views"
        mc:Ignorable="d"
        Title="관리비 매니저" Height="720" Width="1100">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#333333">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <StackPanel.Resources>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FontSize" Value="16"/>
                        <Setter Property="Margin" Value="10,0"/>
                        <Setter Property="Padding" Value="10,5"/>
                        <Setter Property="Cursor" Value="Hand"/>
                    </Style>
                </StackPanel.Resources>

                <TextBlock Text="🏠 MyHome" Foreground="White" FontWeight="Bold" FontSize="20" VerticalAlignment="Center" Margin="20,0,30,0"/>

                <Button Content="메인" Command="{Binding NavigateCommand}" CommandParameter="Main"/>
                <Button Content="내역 추가" Command="{Binding NavigateCommand}" CommandParameter="Add"/>
                <Button Content="관리비 내역" Command="{Binding NavigateCommand}"  CommandParameter="History"/>
                <Button Content="연도별 비교" Command="{Binding NavigateCommand}" CommandParameter="Yearly"/>
                <Button Content="월별 비교" Command="{Binding NavigateCommand}" CommandParameter="Monthly"/>
                <Button Content="항목별 비교" Command="{Binding NavigateCommand}" CommandParameter="Item"/>
                <Button Content="관리비 불러오기" Command="{Binding NavigateCommand}" CommandParameter="Import"/>
            </StackPanel>
        </Border>

        <!-- 오른쪽 96px은 챗봇 아이콘 자리로 비워 두어, 아이콘이 화면 내용을 가리지 않게 한다 -->
        <ContentControl Grid.Row="1" Content="{Binding CurrentView}" Margin="20,20,96,20"/>

        <!-- 챗봇: 현재 화면 위에 겹쳐서 오른쪽 아래에 띄운다 -->
        <views:ChatWidget Grid.Row="1" DataContext="{Binding Chat}"/>
    </Grid>
</Window>